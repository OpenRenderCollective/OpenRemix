#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../../src/native/forward/shaders/bindings.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 5, std430) writeonly buffer Results { uvec4 results[]; };
void main() {
  uint query = gl_GlobalInvocationID.x;
  if (query >= frame.grid.w * 2u) return;
  uint base = (query / 2u) * ClusterStride;
  bool linear;
  uint count = receiverLightCount(base, (query & 1u) == 0u, linear);
  uint first = count == 0u ? 0xffffffffu : linear ? 0u : clusters[base + ClusterHeaderWords];
  uint last = count == 0u ? 0xffffffffu : linear ? count - 1u
      : clusters[base + ClusterHeaderWords + count - 1u];
  results[query] = uvec4(count, uint(linear), first, last);
}
