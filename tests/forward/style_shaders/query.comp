#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#define IRRADIANCE_BINDING 0
#define STYLED_BAKE
layout(set = 0, binding = 1, std140) uniform Weights { vec4 scales[32]; } weights;
#define STYLE_SCALE(style) weights.scales[(style) / 4u][(style) % 4u]
#include "../../../src/native/forward/shaders/irradiance.glsl"
#include "../../../src/native/forward/shaders/style-lighting.glsl"
struct QueryFrame { vec4 localSettings; uvec4 occlusion, clusterInfo; };
QueryFrame frame = QueryFrame(vec4(0), uvec4(0), uvec4(0));
#include "../../../src/native/forward/shaders/lightmap.glsl"
struct Query { vec4 coordinate, normal; uvec4 control; };
layout(set = 0, binding = 2, std430) readonly buffer Queries { Query queries[]; };
layout(set = 0, binding = 3, std430) writeonly buffer Values { vec4 values[]; };
layout(push_constant) uniform Count { uint count; } dispatch;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= dispatch.count) return;
  Query q = queries[i];
  vec3 normal = normalize(q.normal.xyz), result = vec3(0);
  float sh[9];
  surfaceBasis(normal, sh);
  bool found = true;
  if (q.control.x == 0u) result = styledSurfaceIrradiance(q.coordinate, sh);
  else if (q.control.x == 1u) result = styledProbeIrradiance(q.control.y, sh);
  else if (q.control.x == 2u) found = bakedIrradiance(q.coordinate.xyz, normal, result);
  else {
    vec4 surface;
    found = surfaceIrradiance(q.coordinate, normal, surface);
    if (found) result = surface.rgb;
  }
  values[i] = found ? vec4(result, 1) : vec4(0);
}
