#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
struct Ray { vec4 origin; vec4 direction; uvec4 selection; };
layout(set = 0, binding = 1, std430) readonly buffer Rays { Ray rays[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Hits { vec4 hits[]; };
layout(push_constant) uniform Count { uint count; } dispatch;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= dispatch.count) return;
  Ray ray = rays[i];
  rayQueryEXT query;
  rayQueryInitializeEXT(query, scene, 0, 255, ray.origin.xyz, ray.origin.w, ray.direction.xyz, ray.direction.w);
  while (rayQueryProceedEXT(query)) {
    if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
        rayQueryGetIntersectionPrimitiveIndexEXT(query, false) != ray.selection.x)
      rayQueryConfirmIntersectionEXT(query);
  }
  vec4 hit = vec4(-1);
  if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT)
    hit = vec4(rayQueryGetIntersectionTEXT(query, true),
      float(rayQueryGetIntersectionPrimitiveIndexEXT(query, true)),
      rayQueryGetIntersectionBarycentricsEXT(query, true));
  hits[i] = hit;
}
