OpenRemix's MSL fixes on upstream SPIRV-Cross (toolchain.lock.json spirv-cross-msl), applied by
toolchain.py after fetching. From cr's fork (sambow23/SPIRV-Cross 9f9991c5), rebased on main:
- A physical pointer member is copied as a value, not through its pointee (struct copies holding
  buffer references: no viable overloaded '=').
- Atomics on one lane of a vector take the vector's address plus the lane (MSL has no lane addresses).
- 'ray' is reserved: GLSL names collide with Metal's ray tracing namespace.

diff --git a/spirv_glsl.cpp b/spirv_glsl.cpp
index c99d3e48..393f86e9 100644
--- a/spirv_glsl.cpp
+++ b/spirv_glsl.cpp
@@ -20429,7 +20429,16 @@ void CompilerGLSL::emit_copy_logical_type(uint32_t lhs_id, uint32_t lhs_type_id,
 	// when a struct points back to itself.
 	bool is_pointer = is_physical_pointer(lhs_type);
 
-	if (!lhs_type.array.empty() && !is_pointer)
+	if (lhs_type.pointer)
+	{
+		// A physical pointer is a value, not an inline copy of its pointee.
+		auto lhs = access_chain_internal(lhs_id, chain.data(), uint32_t(chain.size()),
+		                                 ACCESS_CHAIN_INDEX_IS_LITERAL_BIT, nullptr, nullptr);
+		auto rhs = access_chain_internal(rhs_id, chain.data(), uint32_t(chain.size()),
+		                                 ACCESS_CHAIN_INDEX_IS_LITERAL_BIT, nullptr, nullptr);
+		statement(lhs, " = ", rhs, ";");
+	}
+	else if (!lhs_type.array.empty() && !is_pointer)
 	{
 		// Could use a loop here to support specialization constants, but it gets rather complicated with nested array types,
 		// and this is a rather obscure opcode anyways, keep it simple unless we are forced to.
