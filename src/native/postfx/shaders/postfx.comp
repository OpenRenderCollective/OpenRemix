#version 450
layout(binding=0) uniform sampler2D sourceImage;
layout(binding=1) uniform sampler2D secondImage;
layout(binding=2,rgba16f) writeonly uniform image2D outputImage;
layout(binding=3,std430) buffer Partials { vec2 partials[]; } tiles;
layout(binding=4,std430) buffer State { vec4 exposure; } state;
layout(push_constant) uniform Settings {
  uvec2 size; uint groups; float centre;
  float target; float blend; float minEv; float maxEv;
  float radius; uint reset; uint meterMode;
} settings;
#if POST_PASS < 2
#if POST_PASS == 0
layout(local_size_x=16,local_size_y=16) in;
#else
layout(local_size_x=256) in;
#endif
shared vec2 sums[256];
bool finite3(vec3 v) { return !any(isnan(v))&&!any(isinf(v)); }
void main() {
  uint index=gl_LocalInvocationIndex;
  vec2 sum=vec2(0);
#if POST_PASS == 0
  uvec2 pixel=gl_GlobalInvocationID.xy;
  if(all(lessThan(pixel,settings.size))) {
    vec2 uv=(vec2(pixel)+.5)/vec2(settings.size);
    vec4 source=texelFetch(sourceImage,ivec2(pixel),0);
    vec3 radiance=source.rgb;
    ivec2 guideSize=textureSize(secondImage,0);
    vec3 albedo=texelFetch(secondImage,min(ivec2(uv*guideSize),guideSize-1),0).rgb;
    bool sceneRadiance=settings.meterMode==1u;
    if(finite3(radiance)&&finite3(albedo)&&(!sceneRadiance||(source.a>0&&!isinf(source.a)))) {
      vec3 light=sceneRadiance ? max(radiance/max(source.a,1e-6)+albedo,vec3(0))
                              : max(radiance,vec3(0))*.18/max(albedo,vec3(.05));
      float average=dot(light,sceneRadiance ? vec3(.2126,.7152,.0722) : vec3(1.0/3.0));
      vec2 offset=(uv-.5)*2;
      offset.x*=float(settings.size.x)/float(settings.size.y);
      float weight=1-settings.centre*smoothstep(0,1,length(offset));
      if(sceneRadiance)weight*=clamp(source.a,0,1);
      if(!isnan(average)&&!isinf(average))sum=vec2(weight*log(max(average,1e-4)),weight);
    }
  }
#else
  for(uint i=index;i<settings.groups;i+=256)sum+=tiles.partials[i];
#endif
  sums[index]=sum;
  barrier();
  for(uint stride=128;stride>0;stride>>=1) {
    if(index<stride)sums[index]+=sums[index+stride];
    barrier();
  }
  if(index!=0)return;
#if POST_PASS == 0
  uint groupsX=(settings.size.x+15)/16;
  tiles.partials[gl_WorkGroupID.y*groupsX+gl_WorkGroupID.x]=sums[0];
#else
  if(!(sums[0].y>0)||isnan(sums[0].x)||isinf(sums[0].x)) {
    if(settings.reset!=0)state.exposure.z=0;
    // Preserve history while reporting a paused, empty radiance meter.
    else if(settings.meterMode==1u&&state.exposure.z>0)state.exposure.z=2;
    return;
  }
  float mean=exp(sums[0].x/sums[0].y);
  float wanted=settings.target/max(mean,1e-4);
  float target=clamp(wanted,exp2(settings.minEv),exp2(settings.maxEv));
  float blend=state.exposure.z>0&&settings.reset==0?settings.blend:1;
  state.exposure=vec4(mix(state.exposure.x,target,blend),target,1,wanted<target?-1:wanted>target?1:0);
#endif
}
#else
layout(local_size_x=8,local_size_y=8) in;
void main() {
  ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(pixel,ivec2(settings.size))))return;
  vec2 uv=(vec2(pixel)+.5)/vec2(settings.size);
  vec3 color=vec3(0);
#if POST_PASS == 2
  // Reference filter: four inner taps share half the weight; nine outer
  // taps share the other half. Black border is intentional.
  vec2 stepSize=.5/vec2(settings.size);
  for(int y=-1;y<=1;y+=2)for(int x=-1;x<=1;x+=2)
    color+=textureLod(sourceImage,uv+vec2(x,y)*stepSize,0).rgb*.125;
  for(int y=-2;y<=2;y+=2)for(int x=-2;x<=2;x+=2)
    color+=textureLod(sourceImage,uv+vec2(x,y)*stepSize,0).rgb*(.5/9);
#else
  vec2 stepSize=1.0/vec2(textureSize(sourceImage,0));
  for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x)
    color+=textureLod(sourceImage,uv+vec2(x,y)*stepSize,0).rgb*float((x==0?2:1)*(y==0?2:1))/16;
  color=mix(textureLod(secondImage,uv,0).rgb,color,settings.radius);
#endif
  imageStore(outputImage,pixel,vec4(color,1));
}
#endif
