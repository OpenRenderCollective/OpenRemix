#version 460
#extension GL_GOOGLE_include_directive : require
#include "inputs.glsl"
#include "../../pathtrace/shaders/debug.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(push_constant) uniform Pass { uint mode; uint step; } pass;
ivec2 bounded(ivec2 p) { return clamp(p,ivec2(0),ivec2(temporal.target.xy)-1); }
vec4 normalRoughnessAt(ivec2 p) { return NRD_FrontEnd_UnpackNormalAndRoughness(imageLoad(guideNormal,bounded(p))); }
vec3 normalAt(ivec2 p) { return normalRoughnessAt(p).xyz; }
float depthAt(ivec2 p) { return imageLoad(guideDepth,bounded(p)).x; }
vec3 viewPosition(vec2 uv,float z) {
  vec4 ray=temporal.previousView*temporal.previousInverseCamera*vec4(uv*2-1,.99999,1);
  return ray.xyz*(z/max(abs(ray.z),1e-8));
}
vec4 gradient(ivec2 p) { return (pass.step&1u)!=0?imageLoad(gradientA,p):imageLoad(gradientB,p); }
vec4 movingGradient(ivec2 p) { return (pass.step&1u)!=0?imageLoad(movingA,p):imageLoad(movingB,p); }
// The filtered moving-surface tiles (movingB) at a full-resolution pixel:
// bilinear over the followed ones. y == 0: none there.
vec4 movingAt(vec2 pixel) {
  ivec2 small=imageSize(movingB)-1;
  vec2 at=(pixel+.5)/5-.5;ivec2 base=ivec2(floor(at));vec2 f=at-vec2(base);
  vec4 sum=vec4(0);float weight=0;
  for(int y=0;y<2;++y)for(int x=0;x<2;++x) {
    vec4 v=imageLoad(movingB,clamp(base+ivec2(x,y),ivec2(0),small));
    float w=(x==0?1-f.x:f.x)*(y==0?1-f.y:f.y)*step(1e-12,v.y);
    sum+=v*w;weight+=w;
  }
  return weight>1e-4?sum/weight:vec4(0);
}
// History confidence for a relative change of light per frame: the history
// length it leaves (1/(1-c) frames) lags by at most the tolerated error.
float changeConfidence(float change) { return clamp(1-change/max(temporal.motionGradient.z,1e-4),0,1); }
vec3 compressed(vec3 c) { return c/(1+max(c.r,max(c.g,c.b))); }
float uncharted(float x) { return ((x*(.22*x+.03)+.002)/(x*(.22*x+.3)+.06))-(.01/.3); }
float toSrgb(float x) { return x<=.0031308?12.92*x:1.055*pow(x,1.0/2.4)-.055; }
vec3 expanded(vec3 c) { return c/max(1-max(c.r,max(c.g,c.b)),1e-5); }
vec4 historyAt(ivec2 p) { return temporal.flags.w==0?imageLoad(history0,bounded(p)):imageLoad(history1,bounded(p)); }
vec4 historyFiltered(vec2 p) {
  ivec2 base=ivec2(floor(p));vec2 f=fract(p);
  return mix(mix(historyAt(base),historyAt(base+ivec2(1,0)),f.x),mix(historyAt(base+ivec2(0,1)),historyAt(base+1),f.x),f.y);
}
// Catmull-Rom over 4x4 history texels. Bilinear resampling low-passes the
// history once per frame of subpixel motion: after the 20 frames a history
// lasts, anything moving on screen (object or camera motion alike) had lost
// about 40% of its texture detail. The lobes' overshoot is bounded by the
// neighbourhood clip that follows; the blend rate (a) stays bilinear.
vec4 historySharp(vec2 p) {
  ivec2 base=ivec2(floor(p));vec2 f=fract(p);
