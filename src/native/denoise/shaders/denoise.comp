  vec4 wy=vec4(((-.5*f.y+1)*f.y-.5)*f.y,(1.5*f.y-2.5)*f.y*f.y+1,((-1.5*f.y+2)*f.y+.5)*f.y,(.5*f.y-.5)*f.y*f.y);
