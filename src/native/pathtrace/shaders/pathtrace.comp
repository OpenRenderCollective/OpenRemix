        vec4 front=imageLoad(frontAlbedo,pixel);
        if(temporal.translucency.x!=0&&sheetCount==1&&front.a>0)imageStore(frontAlbedo,pixel,vec4(front.rgb,hit.color.a));
#endif
      }
#ifdef TEMPORAL
      if(temporal.hitDistance.w!=0) {
        // Deterministic material guides follow the same transparent composition
        // as radiance. Geometry guides remain consistently on the background.
        transparentDiffuse+=tint*hit.color.a*(hit.color.rgb+hit.self)*(hit.pbr?1-hit.rm.y:1);
        if(hit.pbr)transparentSpecular+=tint*hit.color.a*rrSpecularAlbedo(mix(vec3(.04),hit.color.rgb,hit.rm.y),hit.rm.x,dot(hit.n,hit.wo));
      }
#endif
      if(frame.firefly.z!=0)transparentMaterial+=tint*hit.color.a*(hit.color.rgb+hit.self);
      transparent+=tint*hit.color.a*surfaceLight;
      tint*=through;opacityProduct*=1-hit.color.a;
    if(layer+1<sheetCount)primary=cameraHit(offsetRay(primary.p,-primary.ng),layerDirection);
  }
  if(frame.firefly.z!=0)imageStore(meterMaterial,pixel,vec4(transparentMaterial+tint*imageLoad(meterMaterial,pixel).rgb,1));
  float depth=1;
  if(frame.target.w!=0) {
    depth=imageLoad(primaryDepth,ivec2((vec2(pixel)+0.5)*vec2(imageSize(primaryDepth))/vec2(frame.target.xy))).x;
  } else {
    // Stable center-ray depth for raster feedback; blended sheets do not write
    // depth, matching the raster material contract. This ray adds no illumination.
    vec2 centerNdc=(vec2(pixel)+vec2(0.5))/vec2(frame.target.xy)*2-1;
    vec4 centerNear=frame.inverseCamera*vec4(centerNdc,0,1);
    vec4 centerFar=frame.inverseCamera*vec4(centerNdc,0.99999,1);
    vec3 depthOrigin=centerNear.xyz/centerNear.w;
    vec3 depthDirection=normalize(centerFar.xyz/centerFar.w-depthOrigin);
    // The centre sample has its own coverage: this depth is what raster
    // overlays and depth-tested mask sources test.
    uint centerCut=frame.cutConfig.x!=0u?cutCoverage(centerNdc*.5+.5):0u;
    for (uint layer=0;layer<32;++layer) {
      cameraCut=centerCut;cameraRay=frame.cameraCull.x!=0u;
      Hit hit=closestGeometry(depthOrigin,depthDirection,1e30,false);
      cameraCut=0u;cameraRay=false;
      if (hit.t==1e30) break;
      if (!hit.blendedDraw) {
        vec4 clip=frame.camera*vec4(hit.p,1);
        depth=clamp(clip.z/clip.w,0,1);break;
      }
      depthOrigin=offsetRay(hit.p,-hit.ng);
    }
  }
  // Volumetrics: the medium in front of the first surface that is not a
  // blended sheet (the depth above), over everything composed here. The
  // material guides stay as they are: the medium has no albedo to demodulate.
  vec3 guideTint=tint,fogLight=vec3(0);float fogTransmittance=1;
  // The sky is not at its geometry: the raster depth of a sky box's faces
  // drew the box into the medium, edges, corners and all.
  float far=1e30;
  if(frame.volumeConfig.x!=0u||frame.cameraMedium.w>0) {
    float kind=frame.target.w!=0?imageLoad(primaryNormal,pixel).w:-1;
    if(kind>=8)kind-=8; // a view model
    if(kind>0&&kind<2)far=length(imageLoad(primaryPosition,pixel).xyz-origin);
    else if(kind!=0&&depth<1) {
      vec4 surface=frame.inverseCamera*vec4((vec2(pixel)+.5)/vec2(frame.target.xy)*2-1,depth,1);
      far=length(surface.xyz/surface.w-origin);
    }
  }
  if(frame.volumeConfig.x!=0u) {
    volumeMarch(origin,direction,far,fogLight,fogTransmittance);
    transparent=fogLight+fogTransmittance*transparent;tint*=fogTransmittance;
  }
  // A camera inside a translucent body (under water): its medium up to the
  // first surface, sheet or not, nearest of all. Guides stay on the surfaces.
  if(frame.cameraMedium.w>0) {
    vec3 mediumTransmittance;
    vec3 mediumLight=cameraMedium(firstSheet>=0?firstSheet:far,mediumTransmittance);
    transparent=mediumLight+mediumTransmittance*transparent;tint*=mediumTransmittance;
    fogLight=mediumLight+mediumTransmittance*fogLight;fogTransmittance*=dot(mediumTransmittance,vec3(.2126,.7152,.0722));
  }
#if defined(TEMPORAL) && defined(SINGLE_SHEET_PASS)
  // The denoised front sheet is composed later: behind the media as well.
  if(temporal.translucency.x!=0&&sheetCount==1&&fogTransmittance<1) {
    vec4 front=imageLoad(frontAlbedo,pixel);
    if(front.a>0)imageStore(frontAlbedo,pixel,vec4(front.rgb,front.a*fogTransmittance));
  }
#endif
  vec3 color=transparent+tint*uintBitsToFloat(background.rgb);
#ifdef TEMPORAL
  vec3 foreground=transparent;
#ifdef SINGLE_SHEET_PASS
  // Emission and transmission remain unfiltered; NRD supplies the two surface
  // lighting lobes during composition. Raw world output retains full radiance.
  if(temporal.translucency.x!=0&&sheetCount==1)foreground=fogLight+fogTransmittance*primary.color.a*primary.emission;
#endif
  if(temporal.hitDistance.w!=0) {
    imageStore(composed,pixel,vec4(safeRadiance(foreground+tint*imageLoad(composed,pixel).rgb),1));
    imageStore(rrDiffuse,pixel,vec4(transparentDiffuse+guideTint*imageLoad(rrDiffuse,pixel).rgb,0));
    imageStore(rrSpecular,pixel,vec4(transparentSpecular+guideTint*imageLoad(rrSpecular,pixel).rgb,0));
  }
  imageStore(transparentLight,pixel,vec4(safeRadiance(foreground+tint*imageLoad(primaryPrevious,pixel).rgb),1));
  imageStore(transmittance,pixel,vec4(signedCount<0?vec3(0):tint,opacityProduct));
#endif
  float count=float(frame.config.w);
  if (count>0) {
    color=(imageLoad(worldColor,pixel).rgb*count+color)/(count+1);
  }
  if(frame.splitLocal.w!=0)color=uintBitsToFloat(background.rgb);
  imageStore(worldColor,pixel,vec4(color,depth));
  imageStore(backgroundTransmission,pixel,uvec4(0,0,0,floatBitsToUint(1.0)));
#endif
#endif
}
