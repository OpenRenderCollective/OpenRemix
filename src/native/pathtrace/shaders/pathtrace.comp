    vec3 mediumTransmittance;
    vec3 mediumLight=cameraMedium(firstSheet>=0?firstSheet:far,mediumTransmittance);
    transparent=mediumLight+mediumTransmittance*transparent;tint*=mediumTransmittance;
    fogLight=mediumLight+mediumTransmittance*fogLight;fogTransmittance*=dot(mediumTransmittance,vec3(.2126,.7152,.0722));
  }
#if defined(TEMPORAL) && defined(SINGLE_SHEET_PASS)
  // The denoised front sheet is composed later: behind the media as well.
  if(temporal.translucency.x!=0&&sheetCount==1&&fogTransmittance<1) {
    vec4 front=imageLoad(frontAlbedo,pixel);
    if(front.a>0)imageStore(frontAlbedo,pixel,vec4(front.rgb,front.a*fogTransmittance));
  }
#endif
  vec3 color=transparent+tint*uintBitsToFloat(background.rgb);
#ifdef TEMPORAL
  vec3 foreground=transparent;
#ifdef SINGLE_SHEET_PASS
  // Emission and transmission remain unfiltered; NRD supplies the two surface
  // lighting lobes during composition. Raw world output retains full radiance.
  if(temporal.translucency.x!=0&&sheetCount==1)foreground=fogLight+fogTransmittance*primary.color.a*primary.emission;
#endif
  if(temporal.hitDistance.w!=0) {
    imageStore(composed,pixel,vec4(safeRadiance(foreground+tint*imageLoad(composed,pixel).rgb),1));
    imageStore(rrDiffuse,pixel,vec4(transparentDiffuse+guideTint*imageLoad(rrDiffuse,pixel).rgb,0));
    imageStore(rrSpecular,pixel,vec4(transparentSpecular+guideTint*imageLoad(rrSpecular,pixel).rgb,0));
  }
  imageStore(transparentLight,pixel,vec4(safeRadiance(foreground+tint*imageLoad(primaryPrevious,pixel).rgb),1));
  imageStore(transmittance,pixel,vec4(signedCount<0?vec3(0):tint,opacityProduct));
#endif
  float count=float(frame.config.w);
  if (count>0) {
    color=(imageLoad(worldColor,pixel).rgb*count+color)/(count+1);
  }
  if(frame.splitLocal.w!=0)color=uintBitsToFloat(background.rgb);
  imageStore(worldColor,pixel,vec4(color,depth));
  imageStore(backgroundTransmission,pixel,uvec4(0,0,0,floatBitsToUint(1.0)));
#endif
#endif
}
