# SPIR-V generated by the build (src/native/meson.build): optimized, XZ streams in embedded.bin,
# which embedded_data.cpp embeds.
pathtrace_shaders = custom_target('pathtrace-shaders',
  output : ['embedded.h', 'embedded.bin', 'embedded_data.cpp'],
  command : shader_generate + ['pathtrace'], depfile : 'embedded.d',
  depend_files : shader_generator_files, env : shader_env)
