#version 450
#extension GL_GOOGLE_include_directive : require
#include "../../../pathtrace/shaders/color.glsl"
layout(push_constant) uniform AtlasSettings { uint encoded; } settings;
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D atlas;
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), size = imageSize(atlas).xy;
  if (any(greaterThanEqual(pixel, size)))
    return;
  vec2 uv = (vec2(pixel) + .5) / vec2(size);
  vec2 ratio = vec2(textureSize(source, 0)) / vec2(size);
  float lod = max(0, log2(max(ratio.x, ratio.y)));
  imageStore(atlas, pixel, clamp(decodeColorTexel(textureLod(source, uv, lod), settings.encoded != 0u), 0, 65000));
}
