#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 64) in;
#define IRRADIANCE_BINDING 0
#include "../../shaders/irradiance.glsl"
layout(set = 0, binding = 1, std430) readonly buffer Parameters {
  uvec4 copyLayout; // base records, local first record, local words, output records
  uvec4 surfaceLayout; // size, pages, layers, reserved
  vec4 scales[32];
} parameters;
#define STYLE_SCALE(style) parameters.scales[(style) / 4u][(style) % 4u]
#include "../../shaders/style-lighting.glsl"
layout(set = 0, binding = 2, std430) writeonly buffer Output { uvec4 records[]; } outputData;
layout(set = 0, binding = 3) uniform sampler2DArray sourceSurface;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2DArray outputSurface;
layout(set = 0, binding = 5, std430) buffer Status { uint invalid; } status;
layout(push_constant) uniform Chunk { uint phase, first, count; } chunk;

vec3 probeContribution(uint index, uint coefficient) {
  vec3 result = vec3(0);
  for (uint group = 0u; group < styleWord(3u); ++group) {
    uint entry = 12u + group * 8u;
    float scale = STYLE_SCALE(styleWord(entry));
    if (scale == 0) continue;
    uint record = styleWord(styleWord(entry + 2u) + index);
    result += scale * styledCoefficient(styleWord(entry + 3u), record, coefficient);
  }
  return result;
}
void surfaceContributions(uint page, uvec2 pixel, uint size, out vec3 result[9]) {
  [[unroll]] for (uint band = 0u; band < 9u; ++band) result[band] = vec3(0);
  uint wide = (size + 15u) / 16u;
  for (uint group = 0u; group < styleWord(3u); ++group) {
    uint entry = 12u + group * 8u;
    float scale = STYLE_SCALE(styleWord(entry));
    if (scale == 0) continue;
    uint record = styledSurfaceRecord(styleWord(entry + 1u), page, pixel, wide);
    if (record == 0u) continue;
    uint pool = styleWord(entry + 3u);
    [[unroll]] for (uint band = 0u; band < 9u; ++band) {
      result[band] += scale * styledCoefficient(pool, record, band);
    }
  }
}
void checkValue(vec4 value, bool halfValue) {
  if (any(isnan(value)) || any(isinf(value)) || (halfValue && any(greaterThan(abs(value), vec4(65504)))))
    atomicOr(status.invalid, 1u);
}
uvec4 inputRecord(uint record) {
  if (record == 0u) return floatBitsToUint(bakeOriginSpacing);
  if (record == 1u) return bakeDimensions;
  if (record == 2u) return floatBitsToUint(bakeSettings);
  return bakeRecords[record - 3u];
}
float roundedHalf(float value) {
  // Image-store and packHalf conversions can truncate on the device. Round
  // explicitly to an exactly representable half before writing the image.
  if (abs(value) < 0.00006103515625) return roundEven(value * 16777216.0) / 16777216.0;
  uint bits = floatBitsToUint(value);
  bits += 0xfffu + ((bits >> 13u) & 1u);
  return uintBitsToFloat(bits & ~0x1fffu);
}
void storeSurface(ivec3 coordinate, vec4 value) {
  checkValue(value, true);
  value = vec4(roundedHalf(value.x), roundedHalf(value.y), roundedHalf(value.z), roundedHalf(value.w));
  imageStore(outputSurface, coordinate, value);
}
void main() {
  uint thread = gl_GlobalInvocationID.x;
  if (thread >= chunk.count) return;
  uint index = chunk.first + thread;
  if (chunk.phase == 0u) {
    uvec4 value = uvec4(0);
    if (index < parameters.copyLayout.x) {
      value = inputRecord(index);
      if (index == 2u) {
        // Preserve depth/addressing. Omit style storage and relocate the local
        // visibility tail; its internal offsets are relative to that tail.
        value.w &= 0x80000000u;
        if (parameters.copyLayout.z != 0u) value.w |= (parameters.copyLayout.x - 3u) << 1u;
      } else if (index >= 3u && index - 3u < bakeDimensions.w * 16u && (index - 3u) % 16u < 9u) {
        uint probe = (index - 3u) / 16u, coefficient = (index - 3u) % 16u;
        vec4 combined = uintBitsToFloat(value);
        combined.rgb += probeContribution(probe, coefficient);
        checkValue(combined, false);
        value = floatBitsToUint(combined);
      }
    } else {
      uint word = (index - parameters.copyLayout.x) * 4u;
      for (uint component = 0u; component < 4u; ++component)
        if (word + component < parameters.copyLayout.z)
          value[component] = bakeRecords[parameters.copyLayout.y - 3u + word / 4u][component];
    }
    outputData.records[index] = value;
  } else {
    uint size = parameters.surfaceLayout.x;
    uint layers = parameters.surfaceLayout.z;
    uint page = index / (size * size);
    uvec2 pixel = uvec2(index % size, (index / size) % size);
    uint firstLayer = page * layers;
    vec3 contributions[9];
    surfaceContributions(page, pixel, size, contributions);
    [[unroll]] for (uint band = 0u; band < 9u; ++band) {
      ivec3 coordinate = ivec3(pixel, firstLayer + band);
      vec4 value = texelFetch(sourceSurface, coordinate, 0);
      value.rgb += contributions[band];
      storeSurface(coordinate, value);
    }
    for (uint layer = 9u; layer < layers; ++layer) {
      ivec3 coordinate = ivec3(pixel, firstLayer + layer);
      storeSurface(coordinate, texelFetch(sourceSurface, coordinate, 0));
    }
  }
}
