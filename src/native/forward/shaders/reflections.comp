#version 450
#extension GL_GOOGLE_include_directive : require
#ifdef SSR_FILTER
#include "probes.glsl"
#endif
// All reflection intermediates are current-frame scene-linear data. Sampling
// opaque HDR before reflection composition avoids recursive history feedback.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std140) uniform ReflectionFrame {
  mat4 camera, inverseCamera, view;
  vec4 cameraPosition, trace;
  uvec4 config, target;
}
frame;
#ifdef SINGLE_SAMPLE
layout(set = 0, binding = 1) uniform sampler2D sceneDepth;
layout(set = 0, binding = 2) uniform sampler2D sceneNormals;
layout(set = 0, binding = 3) uniform sampler2D sceneReflectance;
#else
layout(set = 0, binding = 1) uniform sampler2DMS sceneDepth;
layout(set = 0, binding = 2) uniform sampler2DMS sceneNormals;
layout(set = 0, binding = 3) uniform sampler2DMS sceneReflectance;
#endif
layout(set = 0, binding = 4) uniform sampler2D opaqueColor;
layout(set = 0, binding = 5) uniform sampler2D normals;
layout(set = 0, binding = 6) uniform sampler2D reflectance;
layout(set = 0, binding = 7) uniform sampler2D depthPyramid;
layout(set = 0, binding = 8, rgba16f) writeonly uniform image2D outNormals;
layout(set = 0, binding = 9, rgba16f) writeonly uniform image2D outReflectance;
layout(set = 0, binding = 10, r32f) writeonly uniform image2D outDepth;
layout(set = 0, binding = 11, rgba16f) writeonly uniform image2D outRadiance;
layout(set = 0, binding = 12) uniform sampler2D rawRadiance;

#include "reflection_math.glsl"
#include "radiance-filter.glsl"
vec3 worldPosition(vec2 uv, float depth) {
  vec4 world = reflectionTransform(frame.inverseCamera, vec4(uv * 2 - 1, depth, 1));
  precise vec3 position = world.xyz / world.w;
  return position;
}
float viewDepth(vec2 uv, float depth) {
  return abs(reflectionTransform(frame.view, vec4(worldPosition(uv, depth), 1)).z);
}
ivec2 surfacePixel(ivec2 lowPixel) {
  return min(lowPixel * int(frame.config.y) + int(frame.config.y) / 2, ivec2(frame.target.xy) - 1);
}

#ifdef SSR_RESOLVE
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(pixel, ivec2(frame.target.xy))))
    return;
  float closest = 1;
  int selected = 0;
#ifdef SINGLE_SAMPLE
  closest = texelFetch(sceneDepth, pixel, 0).r;
#else
  for (uint sampleIndex = 0; sampleIndex < frame.config.x; ++sampleIndex) {
    float candidate = texelFetch(sceneDepth, pixel, int(sampleIndex)).r;
    if (candidate < closest) {
      closest = candidate;
      selected = int(sampleIndex);
    }
  }
#endif
  vec4 normal = vec4(0), specular = vec4(0);
  if (closest < 1) {
    normal = texelFetch(sceneNormals, pixel, selected);
    specular = texelFetch(sceneReflectance, pixel, selected);
  }
  // Normal, F0 and depth always describe the same covered sample. Averaging
  // unrelated surface normals across MSAA silhouettes produces reflection halos.
  imageStore(outNormals, pixel, normal);
  imageStore(outReflectance, pixel, specular);
  imageStore(outDepth, pixel, vec4(closest, closest, 0, 0));
  // The colour source is already MSAA-resolved with premultiplied coverage.
  // Probe/RT-only targets bind a one-pixel dummy instead of a full pyramid.
  if (all(lessThan(pixel, imageSize(outRadiance))))
    imageStore(outRadiance, pixel, finiteRadiance(texelFetch(opaqueColor, pixel, 0)));
}
#endif

#ifdef SSR_REDUCE
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outDepth);
  if (any(greaterThanEqual(pixel, size)))
    return;
  ivec2 inputSize = textureSize(depthPyramid, 0);
  ivec2 begin = pixel * 2;
  // Fold odd trailing rows/columns into the last cell. Dropping those pixels
  // would let a coarse hierarchy step miss valid screen-space geometry.
  ivec2 end = min(begin + 2, inputSize);
  if (pixel.x == size.x - 1)
    end.x = inputSize.x;
  if (pixel.y == size.y - 1)
    end.y = inputSize.y;
  float nearest = 1;
  for (int y = begin.y; y < end.y; ++y)
    for (int x = begin.x; x < end.x; ++x) {
      nearest = min(nearest, texelFetch(depthPyramid, ivec2(x, y), 0).r);
    }
  imageStore(outDepth, pixel, vec4(nearest, 0, 0, 0));
  imageStore(outRadiance, pixel, reduceRadiance(opaqueColor, pixel, size));
}
#endif

#ifdef SSR_TRACE
float cellExit(vec2 position, vec2 direction, ivec2 cell, ivec2 dimensions, float cellSize) {
  vec2 boundary;
  for (int axis = 0; axis < 2; ++axis) {
    float lower = float(cell[axis]) * cellSize / float(frame.target[axis]);
    float upper =
        cell[axis] == dimensions[axis] - 1 ? 1 : float(cell[axis] + 1) * cellSize / float(frame.target[axis]);
    boundary[axis] = direction[axis] > 0 ? upper : lower;
  }
  vec2 distance = vec2(1e30);
  for (int axis = 0; axis < 2; ++axis)
    if (abs(direction[axis]) > 1e-10)
      distance[axis] = max(0, (boundary[axis] - position[axis]) / direction[axis]);
  return min(distance.x, distance.y);
}
vec4 traceReflection(ivec2 pixel) {
  vec4 guide = texelFetch(normals, pixel, 0);
  if (dot(guide.xyz, guide.xyz) < .1 || guide.w >= frame.trace.w)
    return vec4(0);
  vec2 uv = (vec2(pixel) + .5) / vec2(frame.target.xy);
  float depth = texelFetch(depthPyramid, pixel, 0).r;
  if (depth >= 1)
    return vec4(0);
  vec3 p = worldPosition(uv, depth);
  precise vec3 incident = reflectionUnit(p - frame.cameraPosition.xyz);
  precise vec3 normal = reflectionUnit(guide.xyz);
  precise vec3 direction = reflectionDirection(incident, normal);
  float nv = reflectionDot(normal, -incident);
  if (nv <= .01)
    return vec4(0);
  vec3 start = fma(normal, vec3(frame.trace.z), p);
  float distance = frame.trace.x;
  // Stop before crossing the camera plane, where projection becomes singular.
  vec3 viewStart = reflectionTransform(frame.view, vec4(start, 1)).xyz;
  vec3 viewDirection = reflectionTransform(frame.view, vec4(direction, 0)).xyz;
  float viewSign = viewStart.z < 0 ? -1 : 1;
  if (viewDirection.z * viewSign < 0)
    distance = min(distance, (abs(viewStart.z) - max(frame.trace.z, .001)) / abs(viewDirection.z));
  if (distance <= frame.trace.z)
    return vec4(0);
  vec4 a = reflectionTransform(frame.camera, vec4(start, 1));
  vec4 b = reflectionTransform(frame.camera, vec4(fma(direction, vec3(distance), start), 1));
  vec3 origin = a.xyz / a.w, endpoint = b.xyz / b.w;
  origin.xy = fma(origin.xy, vec2(.5), vec2(.5));
  endpoint.xy = fma(endpoint.xy, vec2(.5), vec2(.5));
  vec3 delta = endpoint - origin;
  precise vec2 screenDelta = delta.xy * vec2(frame.target.xy);
  precise float pixelLength = sqrt(fma(screenDelta.x, screenDelta.x, screenDelta.y * screenDelta.y));
  if (pixelLength < 2)
    return vec4(0);
  float limit = 1;
  for (int axis = 0; axis < 2; ++axis) {
    if (delta[axis] > 1e-10)
      limit = min(limit, (1 - origin[axis]) / delta[axis]);
    if (delta[axis] < -1e-10)
      limit = min(limit, -origin[axis] / delta[axis]);
  }
  // Skip the originating pixel. The normal test below also rejects rays
  // travelling out of a surface that screen-depth quantization overlaps.
  float t = min(limit, 1.5 / pixelLength);
  int mip = 0;
  float epsilon = .01 / pixelLength;
  for (uint step = 0; step < frame.config.z && t < limit; ++step) {
    vec3 q = fma(delta, vec3(t), origin);
    if (any(lessThan(q, vec3(0))) || any(greaterThan(q, vec3(1))))
      break;
    float cellSize = exp2(float(mip));
    ivec2 dimensions = textureSize(depthPyramid, mip);
    ivec2 cell = min(ivec2(q.xy * vec2(frame.target.xy) / cellSize), dimensions - 1);
    float exit = min(t + cellExit(q.xy, delta.xy, cell, dimensions, cellSize), limit);
    float endDepth = fma(delta.z, exit, origin.z);
    float surface = texelFetch(depthPyramid, cell, mip).r;
    if (surface >= 1 || max(q.z, endDepth) < surface) {
      t = exit + epsilon;
      mip = min(mip + 1, int(frame.config.w) - 1);
      continue;
    }
    if (mip > 0) {
      --mip;
      continue;
    }
    precise float hitT = q.z >= surface ? t : t + (surface - q.z) / max(delta.z, 1e-10);
    vec3 hit = fma(delta, vec3(hitT), origin);
    float behind = viewDepth(hit.xy, hit.z) - viewDepth(hit.xy, surface);
    vec3 hitNormal = texelFetch(normals, cell, 0).xyz;
    if (hitT <= exit + epsilon && behind >= -frame.trace.z && behind <= frame.trace.y &&
        reflectionDot(hitNormal, direction) < -.001) {
      float colorMip = reflectionColorMip(guide.w, uv, hit.xy, vec2(frame.target.xy), nv);
      vec4 color = finiteRadiance(textureLod(opaqueColor, hit.xy, colorMip));
      float edge = min(min(hit.x, hit.y), min(1 - hit.x, 1 - hit.y));
      float confidence = smoothstep(0, .05, edge) * (1 - smoothstep(.8, 1, hitT));
      confidence *= 1 - smoothstep(frame.trace.w * .75, frame.trace.w, guide.w);
      confidence *= smoothstep(.01, .1, nv) * color.a;
      return vec4(color.rgb / max(color.a, 1e-5) * confidence, confidence);
    }
    t = exit + epsilon;
    mip = min(1, int(frame.config.w) - 1);
  }
  return vec4(0);
}
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(pixel, ivec2(frame.target.zw))))
    return;
  imageStore(outRadiance, pixel, traceReflection(surfacePixel(pixel)));
}
#endif

#ifdef SSR_FILTER
#include "environment.glsl"
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(pixel, ivec2(frame.target.xy))))
    return;
  vec4 guide = texelFetch(normals, pixel, 0);
  float depth = texelFetch(depthPyramid, pixel, 0).r;
  if (depth >= 1 || dot(guide.xyz, guide.xyz) < .1) {
    imageStore(outRadiance, pixel, vec4(0));
    return;
  }
  vec2 uv = (vec2(pixel) + .5) / vec2(frame.target.xy);
  float centerDepth = viewDepth(uv, depth);
  vec2 low = (vec2(pixel) - float(frame.config.y / 2u)) / float(frame.config.y);
  ivec2 base = ivec2(floor(low));
  vec4 radiance = vec4(0);
  float total = 0;
  // Facepunch s&box's 2x2 bilateral upscale; see SBOX-LICENSE.txt.
  // Roughness filtering happens at the hit in the colour mip chain. This pass
  // reconstructs the receiving surface without blurring mirrors at full scale.
  vec2 fractional = low - floor(low);
  for (int y = 0; y <= 1; ++y)
    for (int x = 0; x <= 1; ++x) {
      ivec2 samplePixel = clamp(base + ivec2(x, y), ivec2(0), ivec2(frame.target.zw) - 1);
      ivec2 surface = surfacePixel(samplePixel);
      vec4 sampleGuide = texelFetch(normals, surface, 0);
      float sampleDepth = texelFetch(depthPyramid, surface, 0).r;
      if (sampleDepth >= 1 || dot(sampleGuide.xyz, sampleGuide.xyz) < .1)
        continue;
      float distance = viewDepth((vec2(surface) + .5) / vec2(frame.target.xy), sampleDepth);
      vec2 bilinear = mix(1 - fractional, fractional, vec2(x, y));
      float weight = bilinear.x * bilinear.y;
      weight *= exp(-abs(distance - centerDepth) / max(centerDepth, 1e-4) * 70);
      weight *= pow(max(reflectionDot(reflectionUnit(guide.xyz), reflectionUnit(sampleGuide.xyz)), 0), 6);
      weight *= exp(-abs(guide.w - sampleGuide.w) * 4);
      radiance += texelFetch(rawRadiance, samplePixel, 0) * weight;
      total += weight;
    }
  radiance /= max(total, 1e-6);
  vec3 position = worldPosition(uv, depth);
  vec3 v = reflectionUnit(frame.cameraPosition.xyz - position);
  vec3 f0 = texelFetch(reflectance, pixel, 0).rgb;
  float nv = max(reflectionDot(reflectionUnit(guide.xyz), v), 0);
  vec3 fresnel = f0 + (max(vec3(1 - guide.w), f0) - f0) * pow(1 - nv, 5);
  vec3 fallback;
  vec3 normal = reflectionUnit(guide.xyz), reflected = reflectionDirection(-v, normal);
  if (!probeRadiance(fma(normal, vec3(frame.trace.z), position), reflected, guide.w, fallback))
    fallback = environmentReflection(position, normal, reflected, guide.w);
  radiance.rgb += fallback * (1 - clamp(radiance.a, 0, 1));
  imageStore(outRadiance, pixel, vec4(min(radiance.rgb * fresnel, vec3(65000)), radiance.a));
}
#endif
