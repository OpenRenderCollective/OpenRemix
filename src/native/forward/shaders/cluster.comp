#version 450
#extension GL_GOOGLE_include_directive : require
#define CLUSTER_BUILD
#include "bindings.glsl"
#include "local-light-storage.glsl"
layout(local_size_x = 64) in;
shared vec4 lightBounds[64];
shared vec3 cellMinimum[64], cellMaximum[64];
shared vec3 groupMinimum, groupMaximum;
shared uint candidateMask[4];

bool intersects(vec4 sphere, vec3 minimum, vec3 maximum) {
  vec3 delta = sphere.xyz - clamp(sphere.xyz, minimum, maximum);
  return dot(delta, delta) <= sphere.w * sphere.w;
}
void appendLight(uint base, uint light, inout uint count, inout uint runtimeCount) {
  if (count < ClusterCapacity)
    clusters[base + ClusterHeaderWords + count] = light;
  ++count;
  runtimeCount += uint(light < ClusterLightCount);
}

vec3 viewPoint(vec2 ndc, float depth) {
  vec4 a = frame.inverseProjection * vec4(ndc, 0, 1), b = frame.inverseProjection * vec4(ndc, .9999, 1);
  vec3 pa = a.xyz / a.w, pb = b.xyz / b.w;
  return mix(pa, pb, (depth * frame.depth.w - pa.z) / (pb.z - pa.z));
}
void main() {
  if (gl_WorkGroupID.x * gl_WorkGroupSize.x >= frame.grid.w) return;
  uint index = gl_GlobalInvocationID.x;
  bool validCell = index < frame.grid.w;
  uvec3 cell = uvec3(index % frame.grid.x, (index / frame.grid.x) % frame.grid.y,
                     index / (frame.grid.x * frame.grid.y));
  vec2 low = vec2(cell.xy) / vec2(frame.grid.xy) * 2 - 1;
  vec2 high = vec2(cell.xy + 1u) / vec2(frame.grid.xy) * 2 - 1;
  vec3 minimum = vec3(1e30), maximum = vec3(-1e30);
  for (int z = 0; z < 2; ++z)
    for (int y = 0; y < 2; ++y)
      for (int x = 0; x < 2; ++x) {
        vec3 p =
            viewPoint(vec2(x == 0 ? low.x : high.x, y == 0 ? low.y : high.y), sliceDepth(cell.z + uint(z)));
        minimum = min(minimum, p);
        maximum = max(maximum, p);
      }
  uint count = 0u, runtimeCount = 0u, base = index * ClusterStride;
  uint lightCount = ClusterBakedTail ? frame.target.z : ClusterLightCount;
  // All lanes participate, including the final partial cell workgroup.
  uint lane = gl_LocalInvocationIndex;
  // Reducing the group bounds and sharing masks pays off for large lists.
  // Smaller lists keep the direct per-cell loop.
  bool shareCandidates = lightCount >= 512u;
  if (shareCandidates) {
    cellMinimum[lane] = validCell ? minimum : vec3(1e30);
    cellMaximum[lane] = validCell ? maximum : vec3(-1e30);
    barrier();
    if (lane == 0u) {
      vec3 lower = cellMinimum[0], upper = cellMaximum[0];
      for (uint j = 1u; j < 64u; ++j) {
        lower = min(lower, cellMinimum[j]);
        upper = max(upper, cellMaximum[j]);
      }
      groupMinimum = lower;
      groupMaximum = upper;
    }
  }
  for (uint batch = 0u; batch < lightCount; batch += 64u) {
    uint size = min(64u, lightCount - batch);
    if (lane < size) lightBounds[lane] = lights[batch + lane].clusterBounds;
    barrier();
    if (shareCandidates) {
      // The union of these cells rejects a light for the whole group.
      // Four lanes each encode an ordered block of 16 candidate lights.
      if (lane < 4u) {
        uint begin = lane * 16u, mask = 0u;
        for (uint j = begin; j < min(begin + 16u, size); ++j)
          if (intersects(lightBounds[j], groupMinimum, groupMaximum))
            mask |= 1u << (j - begin);
        candidateMask[lane] = mask;
      }
      barrier();
    }
    if (validCell) {
      if (shareCandidates) {
        for (uint block = 0u; block < 4u; ++block) {
          uint mask = candidateMask[block];
          while (mask != 0u) {
            uint i = block * 16u + uint(findLSB(mask));
            mask &= mask - 1u;
            if (intersects(lightBounds[i], minimum, maximum))
              appendLight(base, batch + i, count, runtimeCount);
          }
        }
      } else {
        for (uint i = 0u; i < size; ++i)
          if (intersects(lightBounds[i], minimum, maximum))
            appendLight(base, batch + i, count, runtimeCount);
      }
    }
    barrier();
  }
  if (!validCell) return;
  clusters[base] = runtimeCount;
  clusters[base + 1u] = count;
}
