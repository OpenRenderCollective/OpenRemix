#version 450
#extension GL_GOOGLE_include_directive : require
#define CLUSTER_BUILD
#include "bindings.glsl"
layout(local_size_x = 64) in;
shared vec4 lightBounds[64];
vec3 viewPoint(vec2 ndc, float depth) {
  vec4 a = frame.inverseProjection * vec4(ndc, 0, 1), b = frame.inverseProjection * vec4(ndc, .9999, 1);
  vec3 pa = a.xyz / a.w, pb = b.xyz / b.w;
  return mix(pa, pb, (depth * frame.depth.w - pa.z) / (pb.z - pa.z));
}
void main() {
  uint index = gl_GlobalInvocationID.x;
  bool validCell = index < frame.grid.w;
  uvec3 cell = uvec3(index % frame.grid.x, (index / frame.grid.x) % frame.grid.y,
                     index / (frame.grid.x * frame.grid.y));
  vec2 low = vec2(cell.xy) / vec2(frame.grid.xy) * 2 - 1;
  vec2 high = vec2(cell.xy + 1u) / vec2(frame.grid.xy) * 2 - 1;
  vec3 minimum = vec3(1e30), maximum = vec3(-1e30);
  for (int z = 0; z < 2; ++z)
    for (int y = 0; y < 2; ++y)
      for (int x = 0; x < 2; ++x) {
        vec3 p =
            viewPoint(vec2(x == 0 ? low.x : high.x, y == 0 ? low.y : high.y), sliceDepth(cell.z + uint(z)));
        minimum = min(minimum, p);
        maximum = max(maximum, p);
      }
  uint count = 0u, runtimeCount = 0u, base = index * ClusterStride;
  uint lightCount = ClusterBakedTail ? frame.target.z : ClusterLightCount;
  // All lanes participate, including the final partial cell workgroup.
  // Only sphere bounds are shared; sorted light indices and overflow counts
  // retain the receiver's existing runtime-prefix/fallback contract.
  uint lane = gl_LocalInvocationIndex;
  for (uint batch = 0u; batch < lightCount; batch += 64u) {
    uint size = min(64u, lightCount - batch);
    if (lane < size) lightBounds[lane] = lights[batch + lane].clusterBounds;
    barrier();
    if (validCell) {
      for (uint j = 0u; j < size; ++j) {
        vec4 sphere = lightBounds[j];
        vec3 delta = sphere.xyz - clamp(sphere.xyz, minimum, maximum);
        if (dot(delta, delta) <= sphere.w * sphere.w) {
          uint i = batch + j;
          if (count < ClusterCapacity)
            clusters[base + ClusterHeaderWords + count] = i;
          ++count;
          runtimeCount += uint(i < ClusterLightCount);
        }
      }
    }
    barrier();
  }
  if (!validCell) return;
  clusters[base] = runtimeCount;
  clusters[base + 1u] = count;
}
