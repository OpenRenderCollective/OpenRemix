#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D opaqueHdr;
#ifdef SINGLE_SAMPLE
layout(set = 0, binding = 1) uniform sampler2D opaqueDepth;
#else
layout(set = 0, binding = 1) uniform sampler2DMS opaqueDepth;
#endif
layout(set = 0, binding = 2) uniform sampler2D opaqueReflections;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D savedHdr;
layout(set = 0, binding = 4, r32f) writeonly uniform image2D savedDepth;
layout(push_constant) uniform Settings { uvec4 target; }; // width, height, samples, flags: reflections/standard samples
#ifndef SINGLE_SAMPLE
layout(constant_id = 0) const uint DepthSamples = 4u;
layout(constant_id = 1) const bool UseDepthTile = true;
vec4 fetchDepthSamples(ivec2 pixel) {
  vec4 values = vec4(texelFetch(opaqueDepth, pixel, 0).r, texelFetch(opaqueDepth, pixel, 1).r, 1, 1);
  if (DepthSamples == 4u)
    values.zw = vec2(texelFetch(opaqueDepth, pixel, 2).r, texelFetch(opaqueDepth, pixel, 3).r);
  return values;
}
// The plane check reads a cross of neighbouring pixels. Cache the tile and
// its one-pixel border once so adjacent invocations can share those samples.
const uint DepthTileSide = gl_WorkGroupSize.x + 2u;
shared vec4 depthTile[DepthTileSide * DepthTileSide];
ivec2 depthTileOrigin() { return ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy) - 1; }
void loadDepthTile() {
  const uint lanes = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
  for (uint index = gl_LocalInvocationIndex; index < DepthTileSide * DepthTileSide; index += lanes) {
    ivec2 offset = ivec2(index % DepthTileSide, index / DepthTileSide);
    ivec2 pixel = clamp(depthTileOrigin() + offset, ivec2(0), ivec2(target.xy) - 1);
    depthTile[index] = fetchDepthSamples(pixel);
  }
  barrier();
}
vec4 waterDepthSamples(ivec2 pixel) {
  if (!UseDepthTile) return fetchDepthSamples(pixel);
  uvec2 offset = uvec2(pixel - depthTileOrigin());
  return depthTile[offset.y * DepthTileSide + offset.x];
}
#include "depth.glsl"
#endif
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
#ifndef SINGLE_SAMPLE
  if (UseDepthTile) loadDepthTile();
#endif
  if (any(greaterThanEqual(pixel, ivec2(target.xy)))) return;
  vec4 hdr = texelFetch(opaqueHdr, pixel, 0);
  // Match display composition before tone mapping. HDR is premultiplied by
  // opaque MSAA coverage; the reflection contribution is scene-linear RGB.
  if ((target.w & 1u) != 0u)
    hdr.rgb += texelFetch(opaqueReflections, pixel, 0).rgb * hdr.a;
  // Keep an extreme emissive/specular sum finite when stored as half floats.
  hdr.rgb = clamp(hdr.rgb, vec3(0), vec3(65000));
  float depth = 1;
#ifdef SINGLE_SAMPLE
  depth = texelFetch(opaqueDepth, pixel, 0).r;
#else
  depth = waterResolvedDepth(pixel);
#endif
  imageStore(savedHdr, pixel, hdr);
  imageStore(savedDepth, pixel, vec4(depth));
}
